# Copy to /etc/xray-panel.env and chmod 600.
PANEL_LISTEN=0.0.0.0:2053
PANEL_DB=/etc/xray-panel/panel.db
PANEL_USERNAME=admin
PANEL_PASSWORD=admin
XRAY_BIN=/usr/local/bin/xray
XRAY_CONFIG=/usr/local/etc/xray/config.json
XRAY_API_ADDR=127.0.0.1:10085
# Xray stdout/stderr log file (default: xray.log next to PANEL_DB)
PANEL_XRAY_LOG=/etc/xray-panel/xray.log
PANEL_WORKERS=2
PANEL_LOG=info
# PANEL_SECURE_COOKIE=true
