[Unit]
Description=xray-panel-rs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PANEL_SYSTEMD=1
EnvironmentFile=/etc/xray-panel.env
# Relative defaults (PANEL_DB/PANEL_XRAY_LOG) must not land in /.
WorkingDirectory=/etc/xray-panel
ExecStart=/usr/local/bin/xray-panel-rs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# Xray binary replacement, the default geofile location (/usr/local/share/xray)
# and the legacy geofile location (the XRAY_BIN directory).
ReadWritePaths=/etc/xray-panel /usr/local/etc/xray /usr/local/bin /usr/local/share/xray
UMask=0077

[Install]
WantedBy=multi-user.target
